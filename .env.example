# Required for local demo staff access; choose a random value >=20 characters.
DEMO_ADMIN_KEY=

# Email delivery is NOT implemented. Enable displayed codes only for synthetic demos.
DEMO_SHOW_LOGIN_CODE=off
DEMO_DAILY_RESET=off

# Blank Turso values use the local ignored database under data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional AI service, configured privately in both environments.
ASSISTANT_API_KEY=
ASSISTANT_BACKEND_URL=http://127.0.0.1:8001
GOOGLE_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_PROVIDER=gemini

# Required for production booking/login unless explicitly bypassed for a synthetic demo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BOT_CHECK=

# Optional Google OAuth, using your own app and callback URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
